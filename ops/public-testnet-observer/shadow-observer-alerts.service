[Unit]
Description=Shadow testnet observer Telegram notifications
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=shadow-alerts
Group=shadow-observer
SupplementaryGroups=shadow-alerts
WorkingDirectory=/opt/shadow-observer/current
ExecStart=/usr/bin/node app/scripts/public-testnet-observer-alerts.mjs --manifest contracts/deployments/public-testnet/arc-testnet.manifest.json --observer-dir /var/lib/shadow-observer --state-dir /var/lib/shadow-alerts --config /etc/shadow-alerts/telegram.json
StateDirectory=shadow-alerts
StateDirectoryMode=0700
TimeoutStartSec=30s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
MemoryMax=96M
CPUQuota=10%
