[Unit]
Description=Shadow read-only public testnet observer
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=shadow-api
Group=shadow-api
WorkingDirectory=/opt/shadow-observer/current
Environment=ARC_RPC_URL=https://rpc.testnet.arc.network
ExecStart=/usr/bin/node app/scripts/public-testnet-observer.mjs --manifest contracts/deployments/public-testnet/arc-testnet.manifest.json --state-dir /var/lib/shadow-observer
StateDirectory=shadow-observer
StateDirectoryMode=0700
TimeoutStartSec=21min
TimeoutStopSec=20s
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
MemoryMax=384M
CPUQuota=25%

