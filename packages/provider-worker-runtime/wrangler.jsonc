{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shadow-provider-runtime-staging",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {"enabled": true, "head_sampling_rate": 1},
  "durable_objects": {"bindings": [
    {"name":"PROVIDER_COORDINATOR","class_name":"ProviderCoordinatorDO"},
    {"name":"RECORD_STORE","class_name":"RecordStoreDO"},
    {"name":"STORE_WITNESS","class_name":"StoreWitnessDO","script_name":"shadow-provider-witness-staging"}
  ]},
  "migrations":[{"tag":"v1","new_sqlite_classes":["ProviderCoordinatorDO","RecordStoreDO"]}]
}
