    "check": "npm run types && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.6.0",
    "@types/node": "24.19.2",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.158.0",
    "viem": "2.55.11"
  }
}
