{
  "name": "@shadow/monitor-worker-runtime",
  "private": true,
  "version": "0.0.0",
  "description": "Durable monitor state and bounded scheduling using the existing observation kernel",
  "type": "module",
  "scripts": {
    "types": "wrangler types --strict-vars=false -c wrangler.test.jsonc",
