{
  "name": "@shadow/provider-durable-store",
  "private": true,
  "version": "0.0.0",
  "description": "Immutable provider records with independent witness publication and bounded capacity reservations",
  "type": "module",
  "scripts": {
    "test:sim": "node --experimental-sqlite --test --test-reporter=spec test/sim/*.test.ts",
    "test:workers": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "types": "wrangler types --strict-vars=false -c wrangler.test.jsonc",
    "types:check": "wrangler types --strict-vars=false -c wrangler.test.jsonc --check",
    "check": "npm run types && npm run typecheck && npm run test:sim && npm run test:workers"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.6.0",
    "@types/node": "24.19.2",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.158.0"
  }
}
