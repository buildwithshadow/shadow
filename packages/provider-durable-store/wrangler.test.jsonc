{
  // LOCAL TEST CONFIG ONLY. Never deploy this fixture. All identity values are synthetic.
  "name": "provider-record-store-prototype",
  "main": "test/fixtures/worker.ts",
  "compatibility_date": "2026-11-04",
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      { "name": "RECORD_STORE", "class_name": "RecordStoreDO" },
      // Recommended for real use: host StoreWitnessDO in a SEPARATE Worker script and bind it here with
      // "script_name": "<witness-script>", so witness migrations/restores never ride with the records.
      { "name": "STORE_WITNESS", "class_name": "StoreWitnessDO" },
      // Test vehicle for the admission model (src/do-provider.ts). Not part of the storage service.
      { "name": "PROVIDER_COORDINATOR", "class_name": "ProviderCoordinatorDO" }
    ]
  },
  "migrations": [
    { "tag": "v1-records", "new_sqlite_classes": ["RecordStoreDO"] },
    { "tag": "v1-witness", "new_sqlite_classes": ["StoreWitnessDO"] },
    { "tag": "v1-provider-model", "new_sqlite_classes": ["ProviderCoordinatorDO"] }
  ],
  "vars": {
    "DEPLOYMENT": "prototype-test",
    "PROVIDER": "0x00000000000000000000000000000000000000a1",
    "CHAIN_ID": "5042002",
    "CONTRACT": "0x00000000000000000000000000000000000000c1",
    "ENDPOINT_HASH": "0x1111111111111111111111111111111111111111111111111111111111111111"
  }
}
